FROM node:22-bookworm-slim

# Dedicated persistent development worker: browser/video tooling lives in the
# image, not in the read-only runtime filesystem or a 128 MB /tmp mount.
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends \
       python3 python3-pip python3-venv git curl ca-certificates \
       ffmpeg libatomic1 fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/devmcp-browsers
ENV PATH=/opt/devmcp-python/bin:$PATH
RUN python3 -m venv /opt/devmcp-python \
    && /opt/devmcp-python/bin/pip install --no-cache-dir "playwright>=1.55,<2" \
    && /opt/devmcp-python/bin/python -m playwright install --with-deps chromium-headless-shell \
    && chmod -R a+rX /opt/devmcp-browsers /opt/devmcp-python

COPY vm_worker.py /opt/devmcp/vm_worker.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/devmcp
CMD ["python3", "/opt/devmcp/vm_worker.py"]
