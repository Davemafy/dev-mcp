FROM node:22-bookworm-slim

# A single direct MCP gateway + local workspace executor on Vultr.
# No separate command-polling container and no Railway dependency.
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends \
      python3 python3-pip python3-venv git curl ca-certificates openssh-client \
      ffmpeg fonts-liberation libatomic1 \
    && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/devmcp-browsers
ENV PATH=/opt/devmcp-python/bin:$PATH
RUN python3 -m venv /opt/devmcp-python
WORKDIR /app
COPY requirements.txt ./
RUN /opt/devmcp-python/bin/pip install --no-cache-dir -r requirements.txt \
      "playwright>=1.55,<2" "pillow>=11,<13" "numpy>=2,<3" "trimesh>=4,<6" \
    && /opt/devmcp-python/bin/python -m playwright install --with-deps chromium-headless-shell \
    && chmod -R a+rX /opt/devmcp-python /opt/devmcp-browsers

COPY auth.py machine.py browser.py host_access.py workspace_host_access.py \
     entrypoint.py main.py backends.py shared_state.py capabilities.py \
     browser_journey.py browser_proxy.py stream_browser.py stream_browser_server.py \
     stream_browser_control.py adaptive_browser.py observation_delta.py \
     progress_guard.py desktop_manager.py desktop_gateway.py desktop_runtime.py \
     agent_jobs.py vm_link.py vm_worker.py host_admin.py direct_vm.py ./
COPY tools/scene_audit.py tools/scene_audit.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    WORKSPACE_BACKEND=local VM_EXECUTION_MODE=direct \
    AUTH_DB_PATH=/data/dev-mcp-auth.sqlite PORT=8000
EXPOSE 8000
CMD ["python", "main.py"]
