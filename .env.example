# Set actual secrets in Railway Variables, never Git.
E2B_API_KEY=your-e2b-api-key
OWNER_PASSWORD=generate-a-random-20-plus-character-password
TOKEN_SIGNING_SECRET=generate-a-separate-random-32-plus-character-secret
PUBLIC_BASE_URL=https://your-service.up.railway.app
E2B_TIMEOUT_SECONDS=1800
MAX_COMMAND_SECONDS=120
MAX_OUTPUT_CHARS=30000
# Optional volume:
AUTH_DB_PATH=/data/dev-mcp-auth.sqlite
# Requires a real Railway volume mounted at /data. Path override is optional:
# HOST_SSH_STATE_DIR=/data/refit-host-ssh

# Backend-independent gateway. Default is E2B.
WORKSPACE_BACKEND=e2b
# For Vercel, ASGI app.py automatically enables stateless mode:
# STATELESS_GATEWAY=1
# AUTH_REDIS_URL=rediss://user:password@your-redis-host:6380/0
# Optional dedicated HTTPS worker backend (requires independent worker):
# WORKSPACE_BACKEND=worker
# WORKER_API_URL=https://your-private-worker.example.com
# WORKER_API_TOKEN=generate-a-random-32-plus-character-token
