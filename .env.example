# Set actual secrets in Railway Variables, never Git.
E2B_API_KEY=your-e2b-api-key
OWNER_PASSWORD=generate-a-random-20-plus-character-password
TOKEN_SIGNING_SECRET=generate-a-separate-random-32-plus-character-secret
PUBLIC_BASE_URL=https://your-service.up.railway.app
E2B_TIMEOUT_SECONDS=1800
MAX_COMMAND_SECONDS=120
MAX_OUTPUT_CHARS=30000
# Optional volume:
AUTH_DB_PATH=/data/dev-mcp-auth.sqlite

# Optional read-only Railway diagnostic bridge (configure on Dev MCP gateway only):
# RAILWAY_PROJECT_TOKEN=your-project-scoped-railway-token
# RAILWAY_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# RAILWAY_SERVICE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# RAILWAY_ENVIRONMENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
